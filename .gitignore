# ---- 编辑器 / IDE ----
# JetBrains（Arduino IDE 2 / CLion 系）的本地状态：workspace.xml 里有本机路径、
# 打开过的文件、运行配置，属于"每个人都不一样"的东西，不该进仓库。
.idea/
*.iml

# VS Code：c_cpp_properties.json 里的 includePath/编译器路径是本机绝对路径，
# 换台机器就失效；settings.json 若将来加入本地配置也一并忽略。
.vscode/
!.vscode/extensions.json

# ---- 编译产物 ----
# .selfcheck 是 PC 端的自检/回归目录，源码要进仓库（它是工程的一部分），
# 但生成的 exe/obj/日志不进。注意：目录一旦被忽略，里面的文件就无法用
# "!" 再捞回来，所以这里只忽略 out/ 子目录本身。
.selfcheck/out/
*.o
*.obj
*.exe
*.elf
*.hex
*.bin
*.map
*.i

# avr_build.ps1 的 AVR 真实构建缓存（core.a 很大，且是可再生产物）
.selfcheck/avrbuild/

# Arduino 构建目录与编辑器临时目录（本工程里出现过 *.tmpdir 残留）
build/
*.tmpdir/

# 编辑器/系统的临时文件
*.tmp
*.bak
*.orig
*.rej
*~
.DS_Store
Thumbs.db

# 日志（探针日志在 .selfcheck/out/ 下，已被上面排除）
*.log

# ---- 交付物与本机文档（按惯例不入库） ----
# dist/ 的发布 zip 与 docs/ 的 Word/PDF 说明文档只留在本地（docs/ 里的
# *.py 生成脚本也一并留在本地）；根目录的手传压缩包、备忘文件与交接
# 说明（HANDOVER*.md）同样只留本地，不进版本库。
/dist/
/docs/
/*.zip
/p1.txt
/HANDOVER*.md

# ---- 第三方只读参照（v1.6.7 运动逻辑替换的来源）----
# others/ 下面是从 GitHub 克隆下来的对照工程（自带 .git 与 5.6MB pack），
# 只在本机当参照读、不随本仓库分发；直接 git add -A 会把它当嵌套仓库写进索引。
/others/

# avr_build.ps1 给单文件 sketch 另建的构建缓存（avrbuild/ 的同类）
.selfcheck/avrbuild*/

# 编译/运行日志的 stderr 片段（*.log 已在上面排除）
*.err
